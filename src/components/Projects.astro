---
import type { Project } from '../types/portfolio';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" class="py-16 bg-stone-100">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-stone-900 mb-8 relative pb-2">
      Proyectos
      <span class="absolute bottom-0 left-0 w-16 h-1 bg-emerald-500"></span>
    </h2>
    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <article class="bg-white border border-stone-200 rounded-xl p-6 hover:shadow-lg transition-shadow flex flex-col">
          <h3 class="text-lg font-semibold text-stone-800 mb-2">{project.title}</h3>
          <p class="text-stone-600 text-sm mb-4 flex-grow">{project.description}</p>
          <div class="flex flex-wrap gap-2 mb-4">
            {project.technologies.map((tech) => (
              <span class="text-xs px-2 py-1 bg-stone-100 text-stone-600 rounded">{tech}</span>
            ))}
          </div>
          <div class="flex gap-4 text-sm font-medium">
            {project.link && (
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-emerald-600 hover:text-emerald-700">
                Ver demo →
              </a>
            )}
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-stone-600 hover:text-stone-800">
                GitHub
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
