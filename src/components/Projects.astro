---
import type { Project } from "../types/portfolio";

interface Props {
  projects: Project[];
  title: {
    title: string;
    demo: string;
    github: string;
  };
}

const { projects, title } = Astro.props;
---

<section id="projects" class="py-16">
  <div class="max-w-4xl mx-auto px-6">
    <h2
      class="text-3xl font-bold text-stone-900 dark:text-white mb-8 relative pb-2"
    >
      {title.title}
      <span class="absolute bottom-0 left-0 w-16 h-1 bg-emerald-500"></span>
    </h2>
    {
      projects.length === 0 ? (
        <div class="glass-card rounded-2xl p-12 text-center">
          <p class="text-stone-500 dark:text-stone-400 text-lg">
            Coming soon...
          </p>
          <p class="text-stone-400 dark:text-stone-500 text-sm mt-2">
            I'm working on new projects. Stay tuned!
          </p>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 gap-6">
          {projects.map((project) => (
            <article class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col">
              <h3 class="text-lg font-semibold text-stone-800 dark:text-white mb-2">
                {project.title}
              </h3>
              <p class="text-stone-600 dark:text-stone-300 text-sm mb-4 flex-grow">
                {project.description}
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                {project.technologies.map((tech) => (
                  <span class="text-xs px-2 py-1 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded">
                    {tech}
                  </span>
                ))}
              </div>
              <div class="flex gap-4 text-sm font-medium">
                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-emerald-600 hover:text-emerald-700"
                  >
                    {title.demo} →
                  </a>
                )}
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-stone-600 dark:text-stone-400 hover:text-stone-800 dark:hover:text-white"
                  >
                    {title.github}
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
