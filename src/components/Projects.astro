---
import type { Project } from "../types/portfolio";

interface Props {
  projects: Project[];
  title: {
    title: string;
    intro: string;
    selectedWork: string;
    impact: string;
    demo: string;
    github: string;
    comingSoon: string;
    workingOn: string;
  };
}

const { projects, title } = Astro.props;
---

<section id="projects" class="py-20" aria-labelledby="projects-heading">
  <div class="max-w-4xl mx-auto px-6">
    <h2
      id="projects-heading"
      class="text-4xl md:text-5xl font-bold text-stone-900 dark:text-white mb-12 relative pb-4 fade-in-up"
    >
      {title.title}
      <span class="absolute bottom-0 left-0 w-24 h-1 bg-primary rounded-full"
      ></span>
    </h2>
    <p
      class="mb-10 max-w-3xl text-lg leading-relaxed text-stone-600 dark:text-stone-300 fade-in-up"
    >
      {title.intro}
    </p>
    {
      projects.length === 0 ? (
        <div class="glass-card rounded-2xl p-12 text-center fade-in-up">
          <p class="text-stone-500 dark:text-stone-400 text-lg">
            {title.comingSoon}
          </p>
          <p class="text-stone-400 dark:text-stone-500 text-sm mt-2">
            {title.workingOn}
          </p>
        </div>
      ) : (
        <div class="grid md:grid-cols-1 gap-10">
          {projects.map((project, index) => (
            <article
              class="project-card group glass-card rounded-3xl p-10 transition-all duration-500 fade-in-up"
              style={`transition-delay: ${index * 0.1}s`}
            >
              <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div>
                  <div class="mb-3 flex items-center gap-3">
                    <span class="text-7xl font-bold text-primary/20 group-hover:text-primary/40 transition-colors">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="inline-flex rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary dark:border-primary-dark/30 dark:bg-primary-dark/10 dark:text-primary-dark">
                      {project.label}
                    </span>
                  </div>
                  <h3 class="mb-3 text-3xl font-semibold text-stone-800 transition-colors group-hover:text-primary dark:text-white">
                    {project.title}
                  </h3>
                  <p class="max-w-3xl text-lg leading-relaxed text-stone-600 dark:text-stone-300">
                    {project.description}
                  </p>
                </div>
                <div class="flex gap-3">
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-6 py-2.5 rounded-full bg-primary flex items-center gap-2 text-white font-medium hover:opacity-90 transition-all"
                      aria-label="View demo"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                      {title.demo}
                    </a>
                  )}
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-6 py-2.5 rounded-full border-2 border-stone-300 dark:border-stone-600 flex items-center gap-2 text-stone-700 dark:text-stone-300 font-medium hover:border-primary hover:text-primary transition-all"
                      aria-label="View code"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.23 3.297-1.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                      </svg>
                      {title.github}
                    </a>
                  )}
                </div>
              </div>

              <div class="mb-6 rounded-2xl border border-stone-200/80 bg-white/70 p-5 dark:border-stone-700 dark:bg-stone-900/50">
                <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-stone-500 dark:text-stone-400">
                  {title.impact}
                </p>
                <p class="text-base leading-relaxed text-stone-700 dark:text-stone-200">
                  {project.outcome}
                </p>
              </div>

              <div class="mb-8">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-stone-500 dark:text-stone-400">
                  {title.selectedWork}
                </p>
                <ul class="space-y-3">
                  {project.highlights.map((highlight) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-stone-700 dark:text-stone-200">
                      <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-primary dark:bg-primary-dark" />
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="flex flex-wrap gap-2 mt-auto">
                {project.technologies.map((tech) => (
                  <span class="text-xs px-3 py-1.5 bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary-dark rounded-full">
                    {tech}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .project-card {
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-primary),
      var(--color-primary-dark)
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s ease;
  }

  .project-card:hover::before {
    transform: scaleX(1);
  }
</style>
