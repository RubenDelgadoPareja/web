---
import type { Project } from "../types/portfolio";

interface Props {
  projects: Project[];
  title: {
    title: string;
    intro: string;
    selectedWork: string;
    impact: string;
    demo: string;
    github: string;
    comingSoon: string;
    workingOn: string;
  };
}

const { projects, title } = Astro.props;
---

<section
  id="projects"
  class="chapter-section bg-[var(--surface)] py-20 md:min-h-[100svh]"
  aria-labelledby="projects-heading"
>
  <div class="mx-auto max-w-5xl px-6">
    <h2
      id="projects-heading"
      class="mb-12 border-b border-[var(--line)] pb-4 text-4xl font-semibold text-[var(--text)] md:text-5xl fade-in-up"
    >
      {title.title}
    </h2>
    {
      title.intro && (
        <p class="mb-10 max-w-3xl text-lg leading-relaxed text-[var(--muted)] fade-in-up">
          {title.intro}
        </p>
      )
    }
    {
      projects.length === 0 ? (
        <div class="rounded-sm border border-[var(--line)] bg-[var(--surface)] p-12 text-center fade-in-up">
          <p class="text-lg text-[var(--muted)]">{title.comingSoon}</p>
          <p class="mt-2 text-sm text-[var(--muted)]">{title.workingOn}</p>
        </div>
      ) : (
        <div class="grid gap-8 md:grid-cols-1">
          {projects.map((project, index) => (
            <article
              class="group rounded-sm border border-[var(--line)] bg-[var(--surface)] p-8 fade-in-up"
              style={`transition-delay: ${index * 0.1}s`}
            >
              <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div>
                  <div class="mb-3 flex items-center gap-3">
                    <span class="text-5xl font-semibold text-[color:color-mix(in_srgb,var(--accent)_26%,white)]">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="inline-flex rounded-sm border border-[var(--line)] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--muted)]">
                      {project.label}
                    </span>
                  </div>
                  <h3 class="mb-3 text-3xl font-semibold text-[var(--text)]">
                    {project.title}
                  </h3>
                  <p class="max-w-3xl text-base leading-relaxed text-[var(--muted)]">
                    {project.description}
                  </p>
                </div>
                <div class="flex gap-3">
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-sm border border-[var(--accent)] bg-[var(--accent)] px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-white"
                      aria-label="View demo"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                      {title.demo}
                    </a>
                  )}
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-sm border border-[var(--line)] px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
                      aria-label="View code"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.23 3.297-1.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                      </svg>
                      {title.github}
                    </a>
                  )}
                </div>
              </div>

              {project.outcome && (
                <div class="mb-6 rounded-sm border border-[var(--line)] bg-transparent p-5">
                  <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--muted)]">
                    {title.impact}
                  </p>
                  <p class="text-base leading-relaxed text-[var(--text)]">
                    {project.outcome}
                  </p>
                </div>
              )}

              <div class="mb-8">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--muted)]">
                  {title.selectedWork}
                </p>
                <ul class="space-y-3">
                  {project.highlights.map((highlight) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-[var(--text)]">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]" />
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="flex flex-wrap gap-2 mt-auto">
                {project.technologies.map((tech) => (
                  <span class="rounded-sm border border-[var(--line)] px-2.5 py-1 text-[11px] font-medium uppercase tracking-[0.08em] text-[var(--muted)]">
                    {tech}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
