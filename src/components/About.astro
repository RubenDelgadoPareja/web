---
import type { ContactLink } from "../types/portfolio";

interface Props {
  name: string;
  about: {
    greeting: string;
    title: string;
    bioLine1: string;
    bioLine2: string;
    availability: string;
    contactLabel: string;
    valueProps: string[];
    cta: string;
    viewProjects: string;
    metrics: {
      experience: string;
      experienceLabel: string;
      projects: string;
      projectsLabel: string;
      focus: string;
      focusLabel: string;
    };
  };
  location: string;
  contactLinks: ContactLink[];
}

const { name, about, location, contactLinks } = Astro.props;

const getIcon = (name: string) => {
  switch (name.toLowerCase()) {
    case "email":
      return `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>`;
    case "linkedin":
      return `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>`;
    case "github":
      return `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>`;
    default:
      return "";
  }
};
---

<section
  id="about"
  class="chapter-section flex min-h-screen items-center border-b border-[var(--line)] bg-[var(--surface)] py-24 md:min-h-[100svh]"
  aria-labelledby="about-heading"
>
  <div class="mx-auto w-full max-w-5xl px-6">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-center lg:gap-20">

      <!-- Columna de texto -->
      <div class="flex-1 min-w-0 fade-in-up">

        <p class="mb-3 text-sm uppercase tracking-[0.22em] text-[var(--muted)]">
          {about.greeting}
        </p>
        <h1
          id="about-heading"
          class="mb-3 text-5xl font-semibold leading-tight text-[var(--text)] md:text-7xl"
        >
          {name}
        </h1>
        <p
          class="mb-8 inline-flex border-b border-[color:color-mix(in_srgb,var(--accent)_35%,white)] pb-1 text-xl font-medium text-[var(--accent)] md:text-2xl"
        >
          {about.title}
        </p>

        <div class="mb-8 flex items-center gap-2 text-sm text-[var(--muted)]">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>{location}</span>
        </div>

        <div class="mb-8 space-y-2 text-lg leading-relaxed text-[var(--muted)] md:text-xl">
          <p>{about.bioLine1}</p>
          <p>{about.bioLine2}</p>
        </div>

        <!-- Métricas -->
        <div class="mb-8 grid grid-cols-3 divide-x divide-[var(--line)] border-t border-b border-[var(--line)] py-5">
          <div class="pr-4 xl:pr-6">
            <p class="text-2xl font-bold tabular-nums text-[var(--text)]">
              {about.metrics.experience}
            </p>
            <p class="mt-1 text-[10px] uppercase leading-tight tracking-[0.18em] text-[var(--muted)]">
              {about.metrics.experienceLabel}
            </p>
          </div>
          <div class="px-4 xl:px-6">
            <p class="text-2xl font-bold tabular-nums text-[var(--text)]">
              {about.metrics.projects}
            </p>
            <p class="mt-1 text-[10px] uppercase leading-tight tracking-[0.18em] text-[var(--muted)]">
              {about.metrics.projectsLabel}
            </p>
          </div>
          <div class="pl-4 xl:pl-6">
            <p class="text-2xl font-bold text-[var(--accent)]">
              {about.metrics.focus}
            </p>
            <p class="mt-1 text-[10px] uppercase leading-tight tracking-[0.18em] text-[var(--muted)]">
              {about.metrics.focusLabel}
            </p>
          </div>
        </div>

        <!-- Botones de contacto -->
        <div class="flex flex-wrap gap-3">
          {
            contactLinks.map((link, index) => (
              <a
                href={link.url}
                class={`inline-flex items-center gap-2 rounded-sm border px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] transition-colors ${
                  index === 0
                    ? "border-[var(--accent)] bg-[var(--accent)] text-white hover:bg-[color:color-mix(in_srgb,var(--accent)_85%,black)]"
                    : "border-[var(--line)] bg-[var(--surface)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
                }`}
                target={
                  link.name.toLowerCase() === "linkedin" || link.name.toLowerCase() === "github"
                    ? "_blank"
                    : undefined
                }
                rel={
                  link.name.toLowerCase() === "linkedin" || link.name.toLowerCase() === "github"
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                <span aria-hidden="true" set:html={getIcon(link.name)} />
                <span>{link.name}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Columna de foto (solo desktop) -->
      <div
        class="hidden lg:block w-60 xl:w-68 shrink-0 fade-in-up"
        style="animation-delay: 280ms"
      >
        <div class="relative">
          <!-- Marco decorativo desplazado -->
          <div
            class="absolute inset-0 translate-x-3 translate-y-3 rounded-sm border border-[var(--accent)] opacity-30 pointer-events-none"
          ></div>
          <img
            src="/avatar.jpeg"
            alt={`Photo of ${name}`}
            class="relative block w-full rounded-sm object-cover object-top"
            loading="eager"
          />
        </div>
      </div>

    </div>
  </div>
</section>
