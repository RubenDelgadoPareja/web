---
interface Props {
  name: string;
  about: {
    greeting: string;
    title: string;
    bio: string;
    cta: string;
  };
  location?: string;
}

const { name, about, location } = Astro.props;
---

<section id="about" class="min-h-[calc(100vh-4rem)] flex items-center py-16">
  <div class="max-w-4xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="order-2 md:order-1">
        <p class="text-emerald-600 font-medium mb-2">{about.greeting}</p>
        <h1 class="text-5xl font-bold text-stone-900 dark:text-white mb-1">{name}</h1>
        <p class="text-xl text-stone-500 dark:text-stone-400 mb-2">{about.title}</p>
        {location && <p class="text-stone-400 dark:text-stone-500 mb-6">📍 {location}</p>}
        <p class="text-stone-600 dark:text-stone-300 mb-8 max-w-lg leading-relaxed">{about.bio}</p>
        <a href="#contact" class="inline-block bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 transition-colors">
          {about.cta}
        </a>
      </div>
      <div class="order-1 md:order-2 flex justify-center">
        <div class="w-64 h-64 rounded-full bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center text-6xl font-bold text-white shadow-xl">
          {name.split(' ').map(n => n[0]).join('')}
        </div>
      </div>
    </div>
  </div>
</section>
