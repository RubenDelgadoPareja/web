---
interface Props {
  name: string;
  title: string;
  bio: string;
}

const { name, title, bio } = Astro.props;
---

<section id="about" class="about">
  <div class="container">
    <div class="about-content">
      <div class="about-text">
        <p class="greeting">Hola, soy</p>
        <h1>{name}</h1>
        <p class="title">{title}</p>
        <p class="bio">{bio}</p>
        <a href="#contact" class="btn">Contactar</a>
      </div>
      <div class="about-image">
        <div class="avatar">
          <span>{name.split(' ').map(n => n[0]).join('')}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: center;
  }

  .greeting {
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .bio {
    max-width: 500px;
    margin-bottom: 2rem;
    color: var(--color-text-muted);
  }

  .avatar {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    font-weight: 700;
    color: white;
  }

  @media (max-width: 768px) {
    .about-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-text {
      order: 2;
    }

    .about-image {
      order: 1;
    }

    .avatar {
      width: 180px;
      height: 180px;
      font-size: 2.5rem;
      margin: 0 auto;
    }

    .bio {
      margin: 0 auto 2rem;
    }

    h1 {
      font-size: 2.5rem;
    }
  }
</style>
