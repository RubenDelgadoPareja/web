---
import type { ContactLink } from "../types/portfolio";

interface Props {
  name: string;
  about: {
    greeting: string;
    title: string;
    bioLine1: string;
    bioLine2: string;
    availability: string;
    contactLabel: string;
    valueProps: string[];
    cta: string;
    viewProjects: string;
    metrics: {
      experience: string;
      experienceLabel: string;
      projects: string;
      projectsLabel: string;
      focus: string;
      focusLabel: string;
    };
  };
  location: string;
  contactLinks: ContactLink[];
}

const { name, about, location, contactLinks } = Astro.props;

const getIcon = (name: string) => {
  switch (name.toLowerCase()) {
    case "email":
      return `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>`;
    case "linkedin":
      return `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>`;
    case "phone":
      return `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>`;
    default:
      return "";
  }
};
---

<section
  id="about"
  class="flex min-h-screen items-center border-b border-[var(--line)] bg-[var(--surface)] py-24"
  aria-labelledby="about-heading"
>
  <div class="mx-auto w-full max-w-5xl px-6 fade-in-up">
    <span
      class="mb-8 inline-flex items-center gap-2 rounded-sm border border-[var(--line)] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.24em] text-[var(--muted)]"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
      {about.availability}
    </span>

    <p class="mb-3 text-sm uppercase tracking-[0.22em] text-[var(--muted)]">
      {about.greeting}
    </p>
    <h1
      id="about-heading"
      class="mb-3 text-5xl font-semibold leading-tight text-[var(--text)] md:text-7xl"
    >
      {name}
    </h1>
    <p class="mb-8 inline-flex border-b border-[color:color-mix(in_srgb,var(--accent)_35%,white)] pb-1 text-xl font-medium text-[var(--accent)] md:text-2xl">
      {about.title}
    </p>

    <div class="mb-8 flex items-center gap-2 text-sm text-[var(--muted)]">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
        ></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <span>{location}</span>
    </div>

    <div class="mb-12 max-w-2xl space-y-2 text-lg leading-relaxed text-[var(--muted)] md:text-xl">
      <p>{about.bioLine1}</p>
      <p>{about.bioLine2}</p>
    </div>

    <div class="flex flex-wrap gap-3">
      {
        contactLinks.map((link, index) => (
          <a
            href={link.url}
            class={`inline-flex items-center gap-2 rounded-sm border px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] transition-colors ${
              index === 0
                ? "border-[var(--accent)] bg-[var(--accent)] text-white"
                : "border-[var(--line)] bg-[var(--surface)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)]"
            }`}
            target={
              link.name.toLowerCase() === "linkedin" ? "_blank" : undefined
            }
            rel={
              link.name.toLowerCase() === "linkedin"
                ? "noopener noreferrer"
                : undefined
            }
          >
            <span aria-hidden="true" set:html={getIcon(link.name)} />
            <span>{link.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
