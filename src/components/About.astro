---
import type { ContactLink } from "../types/portfolio";

interface Props {
  name: string;
  about: {
    greeting: string;
    title: string;
    bio: string;
    cta: string;
    viewProjects: string;
  };
  location: string;
  contactLinks: ContactLink[];
}

const { name, about, location, contactLinks } = Astro.props;

const getIcon = (name: string) => {
  switch (name.toLowerCase()) {
    case 'email':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>`;
    case 'linkedin':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>`;
    case 'phone':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>`;
    default:
      return `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>`;
  }
};
---

<section id="about" class="min-h-screen flex items-center justify-center py-20" aria-labelledby="about-heading">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="order-2 md:order-1 fade-in-up">
        <p class="text-lg text-primary dark:text-primary-dark mb-2">
          {about.greeting}
        </p>
        <h1
          id="about-heading"
          class="text-5xl md:text-6xl font-bold text-stone-900 dark:text-white mb-4"
        >
          {name}
        </h1>
        <p class="text-2xl md:text-3xl font-semibold text-primary dark:text-primary-dark mb-6 relative inline-block">
          {about.title}
          <span class="absolute -bottom-1 left-0 w-full h-1 bg-primary/30 dark:bg-primary-dark/30 rounded-full"></span>
        </p>
        <div class="flex items-center gap-2 text-stone-500 dark:text-stone-400 mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{location}</span>
        </div>
        
        <p class="text-lg text-stone-600 dark:text-stone-300 leading-relaxed">
          {about.bio}
        </p>
      </div>
      
      <div class="order-1 md:order-2 fade-in-up" style="animation-delay: 200ms">
        <div class="relative mb-6">
          <div class="absolute inset-0 bg-primary/20 dark:bg-primary-dark/20 rounded-3xl transform rotate-3"></div>
          <img 
            src="/avatar.jpeg" 
            alt={name}
            class="relative rounded-3xl shadow-2xl w-full max-w-md mx-auto object-cover aspect-square"
          />
        </div>
        
        <div class="flex flex-wrap gap-4 justify-center">
          {contactLinks.map((link) => (
            <a
              href={link.url}
              class="inline-flex items-center justify-center w-12 h-12 bg-primary dark:bg-primary-dark text-white dark:text-stone-900 rounded-full hover:opacity-90 transition-opacity"
              aria-label={link.name}
              target={link.name.toLowerCase() === 'linkedin' ? '_blank' : undefined}
              rel={link.name.toLowerCase() === 'linkedin' ? 'noopener noreferrer' : undefined}
              set:html={getIcon(link.name)}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
