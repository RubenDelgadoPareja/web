---
interface Props {
  title: string;
  experiences: Array<{
    id: string;
    company: string;
    role: string;
    period: string;
    description: string;
    technologies: string[];
  }>;
}

const { title, experiences } = Astro.props;
---

<section id="experience" class="py-20" aria-labelledby="experience-heading">
  <div class="max-w-4xl mx-auto px-6">
    <h2
      id="experience-heading"
      class="text-4xl md:text-5xl font-bold text-stone-900 dark:text-white mb-12 relative pb-4 fade-in-up"
    >
      {title}
      <span class="absolute bottom-0 left-0 w-24 h-1 bg-primary rounded-full"></span>
    </h2>
    
    <div class="space-y-8">
      {experiences?.map((exp, index) => (
        <div 
          class="relative pl-8 border-l-2 border-stone-200 dark:border-stone-700 fade-in-up"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-primary dark:bg-primary-dark border-2 border-white dark:border-stone-900"></div>
          
          <div class="mb-2">
            <span class="inline-block px-3 py-1 text-xs font-medium text-primary dark:text-primary-dark bg-primary/10 dark:bg-primary-dark/20 rounded-full">
              {exp.period}
            </span>
          </div>
          
          <h3 class="text-xl font-semibold text-stone-900 dark:text-white mb-1">
            {exp.role}
          </h3>
          
          <p class="text-lg text-primary dark:text-primary-dark mb-3">
            {exp.company}
          </p>
          
          <p class="text-stone-600 dark:text-stone-300 mb-4 leading-relaxed">
            {exp.description}
          </p>
          
          <div class="flex flex-wrap gap-2">
            {exp.technologies.map((tech) => (
              <span class="px-3 py-1 text-xs font-medium text-stone-700 dark:text-stone-300 bg-stone-100 dark:bg-stone-800 rounded-full">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
