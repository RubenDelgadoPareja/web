---
import type { Experience } from "../types/portfolio";

interface Props {
  experiences: Experience[];
  title: string;
}

const { experiences, title } = Astro.props;
---

<section id="experience" class="py-16">
  <div class="max-w-4xl mx-auto px-6">
    <h2
      class="text-3xl font-bold text-stone-900 dark:text-white mb-8 relative pb-2"
    >
      {title}
      <span class="absolute bottom-0 left-0 w-16 h-1 bg-emerald-500"></span>
    </h2>
    <div class="space-y-6">
      {
        experiences.map((exp) => (
          <article class="glass-card rounded-2xl p-6 transition-all duration-300">
            <div class="flex flex-wrap justify-between items-start gap-4 mb-3">
              <div>
                <h3 class="text-lg font-semibold text-stone-800 dark:text-white">
                  {exp.role}
                </h3>
                <p class="text-emerald-600 font-medium">{exp.company}</p>
              </div>
              <span class="text-sm text-stone-500 dark:text-stone-400 bg-white/50 dark:bg-white/10 px-3 py-1 rounded-full">
                {exp.period}
              </span>
            </div>
            <p class="text-stone-600 dark:text-stone-300 mb-4">
              {exp.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {exp.technologies.map((tech) => (
                <span class="text-xs px-3 py-1 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">
                  {tech}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
