---
import type { Experience } from '../types/portfolio';

interface Props {
  experiences: Experience[];
  title: string;
}

const { experiences, title } = Astro.props;
---

<section id="experience" class="py-16">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-stone-900 mb-8 relative pb-2">
      {title}
      <span class="absolute bottom-0 left-0 w-16 h-1 bg-emerald-500"></span>
    </h2>
    <div class="space-y-6">
      {experiences.map((exp) => (
        <article class="bg-white border border-stone-200 rounded-xl p-6 hover:shadow-lg transition-shadow">
          <div class="flex flex-wrap justify-between items-start gap-4 mb-3">
            <div>
              <h3 class="text-lg font-semibold text-stone-800">{exp.role}</h3>
              <p class="text-emerald-600 font-medium">{exp.company}</p>
            </div>
            <span class="text-sm text-stone-500 bg-stone-100 px-3 py-1 rounded-full">{exp.period}</span>
          </div>
          <p class="text-stone-600 mb-4">{exp.description}</p>
          <div class="flex flex-wrap gap-2">
            {exp.technologies.map((tech) => (
              <span class="text-xs px-3 py-1 bg-stone-100 text-stone-600 rounded">{tech}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
