---
interface Props {
  title: string;
  experiences: Array<{
    id: string;
    company: string;
    role: string;
    period: string;
    description: string;
    highlights: string[];
    technologies: string[];
  }>;
}

const { title, experiences } = Astro.props;
---

<section
  id="experience"
  class="chapter-section border-b border-[var(--line)] bg-[var(--surface-alt)] py-20 md:min-h-[100svh]"
  aria-labelledby="experience-heading"
>
  <div class="mx-auto max-w-5xl px-6">
    <h2
      id="experience-heading"
      class="mb-12 border-b border-[var(--line)] pb-4 text-4xl font-semibold text-[var(--text)] md:text-5xl fade-in-up"
    >
      {title}
    </h2>

    <div class="space-y-8">
      {
        experiences?.map((exp, index) => (
          <div class="fade-in-up" style={`animation-delay: ${index * 100}ms`}>
            <div class="mb-2">
              <span
                class={`inline-block rounded-sm px-2 py-1 text-xs font-medium uppercase tracking-[0.18em] ${index === 0 ? "bg-[color:color-mix(in_srgb,var(--accent)_10%,white)] text-[var(--accent)]" : "text-[var(--muted)]"}`}
              >
                {exp.period}
              </span>
            </div>

            <div
              class={`card-hover rounded-sm border bg-[var(--surface)] p-6 ${index === 0 ? "border-[color:color-mix(in_srgb,var(--accent)_45%,var(--line))] shadow-[0_10px_30px_rgba(21,21,21,0.04)]" : "border-[var(--line)]"}`}
            >
              <div class="mb-4 flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                <div>
                  <h3 class="text-2xl font-semibold text-[var(--text)]">
                    {exp.role}
                  </h3>
                  <p class="text-base text-[var(--accent)]">{exp.company}</p>
                </div>
              </div>

              {exp.description && (
                <p class="mb-5 leading-relaxed text-[var(--muted)]">
                  {exp.description}
                </p>
              )}

              <ul class="mb-5 space-y-3">
                {exp.highlights.map((highlight) => (
                  <li class="flex items-start gap-3 text-sm leading-relaxed text-[var(--text)]">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-2">
                {exp.technologies.map((tech) => (
                  <span class="rounded-sm border border-[var(--line)] bg-transparent px-2.5 py-1 text-[11px] font-medium uppercase tracking-[0.08em] text-[var(--muted)]">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
