---
import type { ContactLink } from "../types/portfolio";

interface Props {
  links: ContactLink[];
  title: string;
  description: string;
}

const { links, title, description } = Astro.props;
---

<section id="contact" class="py-20" aria-labelledby="contact-heading">
  <div class="max-w-4xl mx-auto px-6">
    <div class="glass-card rounded-3xl p-12 md:p-16 text-center fade-in-up relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent"></div>
      <div class="relative z-10">
        <h2 id="contact-heading" class="text-4xl md:text-5xl font-bold text-stone-900 dark:text-white mb-4">
          {title}
        </h2>
        <p class="text-stone-600 dark:text-stone-300 mb-10 max-w-lg mx-auto text-lg">
          {description}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          {
            links.map((link, index) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-8 py-4 bg-emerald-600 text-white rounded-full font-medium hover:bg-emerald-700 hover:scale-105 hover:shadow-xl hover:shadow-emerald-500/30 transition-all fade-in-up flex items-center gap-2 group"
                style={`transition-delay: ${index * 0.1}s`}
              >
                {link.name}
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
