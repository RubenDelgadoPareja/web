---
import type { ContactLink } from '../types/portfolio';

interface Props {
  links: ContactLink[];
}

const { links } = Astro.props;
---

<section id="contact" class="py-16 bg-stone-900 text-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold mb-4">Contacto</h2>
    <p class="text-stone-400 mb-8">¿Interesado en trabajar conmigo? ¡Escríbeme!</p>
    <div class="flex flex-wrap justify-center gap-4">
      {links.map((link) => (
        <a 
          href={link.url} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-6 py-3 bg-stone-800 border border-stone-700 rounded-lg font-medium hover:bg-emerald-600 hover:border-emerald-600 transition-all"
        >
          {link.name}
        </a>
      ))}
    </div>
  </div>
</section>
