---
import type { SkillCategory } from '../types/portfolio';

interface Props {
  categories: SkillCategory[];
  title: string;
}

const { categories, title } = Astro.props;
---

<section id="skills" class="py-16">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-stone-900 dark:text-white mb-8 relative pb-2">
      {title}
      <span class="absolute bottom-0 left-0 w-16 h-1 bg-emerald-500"></span>
    </h2>
    <div class="grid md:grid-cols-3 gap-6">
      {categories.map((category) => (
        <div class="bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 rounded-xl p-6">
          <h3 class="text-base font-semibold text-emerald-600 mb-4">{category.name}</h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <span class="text-sm px-3 py-1.5 bg-stone-100 dark:bg-stone-700 text-stone-700 dark:text-stone-300 rounded-lg">{skill.name}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
