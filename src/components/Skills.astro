---
import type { SkillCategory } from "../types/portfolio";

interface Props {
  categories: SkillCategory[];
  title: string;
}

const { categories, title } = Astro.props;
---

<section id="skills" class="py-20" aria-labelledby="skills-heading">
  <div class="max-w-6xl mx-auto px-6">
    <h2
      id="skills-heading"
      class="text-4xl md:text-5xl font-bold text-stone-900 dark:text-white mb-12 relative pb-4 fade-in-up"
    >
      {title}
    </h2>
    <div class="grid md:grid-cols-3 gap-8">
      {
        categories.map((category, index) => (
          <div class="glass-card rounded-3xl p-8 fade-in-up group hover:-translate-y-2 transition-transform duration-300" style={`transition-delay: ${index * 0.1}s`}>
            <h3 class="text-lg font-semibold text-emerald-600 dark:text-emerald-400 mb-6 flex items-center gap-2">
              <span class="w-8 h-0.5 bg-emerald-500"></span>
              {category.name}
            </h3>
            <div class="flex flex-wrap gap-3">
              {category.skills.map((skill) => (
                <span class="text-sm px-4 py-2 bg-stone-100 dark:bg-white/5 text-stone-700 dark:text-stone-300 rounded-xl border border-stone-200 dark:border-white/10 hover:border-emerald-500/50 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition-all cursor-default">
                  {skill.name}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
