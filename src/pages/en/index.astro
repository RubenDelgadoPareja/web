---
import BaseLayout from '../../layouts/BaseLayout.astro';
import About from '../../components/About.astro';
import Experience from '../../components/Experience.astro';
import Projects from '../../components/Projects.astro';
import Skills from '../../components/Skills.astro';
import Contact from '../../components/Contact.astro';
import type { Experience as ExperienceType, Project, SkillCategory, ContactLink } from '../../types/portfolio';
import { translations } from '../../i18n/utils';

const lang = 'en';
const t = translations[lang];

const experience: ExperienceType[] = [
  {
    id: '1',
    company: 'Your Company',
    role: 'Full Stack Developer',
    period: '2023 - Present',
    description: 'Development of modern web applications with React, Node.js and PostgreSQL databases.',
    technologies: ['React', 'Node.js', 'PostgreSQL', 'TypeScript']
  },
  {
    id: '2',
    company: 'Previous Company',
    role: 'Frontend Developer',
    period: '2021 - 2023',
    description: 'Implementation of responsive user interfaces and performance optimization.',
    technologies: ['JavaScript', 'CSS', 'HTML', 'Vue.js']
  }
];

const projects: Project[] = [
  {
    id: '1',
    title: 'Project 1',
    description: 'Description of your featured project.',
    technologies: ['React', 'TypeScript', 'Node.js'],
    github: 'https://github.com'
  },
  {
    id: '2',
    title: 'Project 2',
    description: 'Another interesting project.',
    technologies: ['Astro', 'Tailwind', 'PostgreSQL'],
    link: 'https://demo.com',
    github: 'https://github.com'
  }
];

const skills: SkillCategory[] = [
  {
    name: 'Frontend',
    skills: [
      { name: 'JavaScript' },
      { name: 'TypeScript' },
      { name: 'React' },
      { name: 'Astro' },
      { name: 'HTML/CSS' }
    ]
  },
  {
    name: 'Backend',
    skills: [
      { name: 'Node.js' },
      { name: 'Python' },
      { name: 'PostgreSQL' },
      { name: 'MongoDB' }
    ]
  },
  {
    name: 'Tools',
    skills: [
      { name: 'Git' },
      { name: 'Docker' },
      { name: 'AWS' },
      { name: 'Linux' }
    ]
  }
];

const contactLinks: ContactLink[] = [
  { name: 'GitHub', url: 'https://github.com' },
  { name: 'LinkedIn', url: 'https://linkedin.com' },
  { name: 'Email', url: 'mailto:youremail@example.com' }
];
---

<BaseLayout title="Ruben Delgado - Software Developer" lang={lang}>
  <About 
    name="Ruben Delgado" 
    about={t.about}
  />
  <Experience experiences={experience} title={t.experience.title} />
  <Projects projects={projects} title={t.projects} />
  <Skills categories={skills} title={t.skills.title} />
  <Contact links={contactLinks} title={t.contact.title} description={t.contact.description} />
</BaseLayout>
