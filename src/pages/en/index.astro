---
import BaseLayout from "../../layouts/BaseLayout.astro";
import About from "../../components/About.astro";
import TechStack from "../../components/TechStack.astro";
import Experience from "../../components/Experience.astro";
import Projects from "../../components/Projects.astro";
import type {
  Experience as ExperienceType,
  Project,
  ContactLink,
} from "../../types/portfolio";
import { translations } from "../../i18n/utils";

const lang = "en";
const t = translations[lang];

const experience: ExperienceType[] = [
  {
    id: "1",
    company: "Nazaries Intelligence",
    role: "Mid-Level Software Developer",
    period: "2025 - Present",
    description:
      "At this stage, I strengthened my experience with CLEAN and hexagonal architecture while deepening my understanding of design patterns and React performance optimization. I worked on a large-scale forms project, first using Formik and later migrating to React Hook Form. I also worked with MobX for state management, started introducing dependency injection with Inversify, and participated in migrating validation logic from class-validator to Zod. Later, I collaborated with El Corte Inglés on the development of a ticket purchasing platform for theaters.",
    technologies: [
      "React",
      "TypeScript",
      "MobX",
      "Inversify",
      "Zod",
      "React Hook Form",
      "CLEAN Architecture",
    ],
  },
  {
    id: "2",
    company: "Nazaries Intelligence",
    role: "Junior Software Developer",
    period: "2023 - 2025",
    description:
      "During this period, I continued working with Ruby on Rails, but soon realized I wanted to focus more on interface development and user experience. I started by strengthening my JavaScript and React skills while supporting different teams with new UI implementations and WordPress styling customizations. Later, I worked with Angular on a virtual library project for children for Santillana, where I also gained experience with Vue.js and Nuxt, as well as additional exposure to Node.js and MongoDB.",
    technologies: [
      "React",
      "Angular",
      "Vue.js",
      "Nuxt",
      "Node.js",
      "MongoDB",
      "JavaScript",
      "WordPress",
      "Jest",
    ],
  },
  {
    id: "3",
    company: "Nazaries Intelligence",
    role: "Internship",
    period: "2022 - 2023",
    description:
      "During my internship, I started working with Ruby on Rails and became familiar with the MVC pattern. I also learned to use Docker and Git in a professional environment. This period gave me the opportunity to contribute to internal company projects, support client maintenance work, and take part in new feature development.",
    technologies: ["Ruby on Rails", "MVC", "Docker", "Git"],
  },
];

const projects: Project[] = [];

const techStack = [
  "React",
  "TypeScript",
  "MobX",
  "Zod",
  "React Hook Form",
  "Vite",
  "Jest",
  "Nuxt",
  "Node.js",
  "MongoDB",
  "JavaScript",
  "WordPress",
  "Vue.js",
  "Ruby on Rails",
  "Docker",
  "Git",
  "Angular",
];

const contactLinks: ContactLink[] = [
  { name: "Email", url: "mailto:ruben051199@gmail.com" },
  {
    name: "LinkedIn",
    url: "https://linkedin.com/in/rubén-delgado-pareja-baaa67206",
  },
  { name: "Phone", url: "tel:+34662000647" },
];
---

<BaseLayout title="Ruben Delgado - Frontend Software Developer" lang={lang}>
  <About
    name="Ruben Delgado"
    about={t.about}
    location="Granada, Spain"
    contactLinks={contactLinks}
  />
  <TechStack technologies={techStack} title={t.techStack.title} />
  <Experience experiences={experience} title={t.experience.title} />
  <Projects projects={projects} title={t.projects} />
</BaseLayout>
