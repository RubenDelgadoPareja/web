---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/About.astro";
import TechStack from "../components/TechStack.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import type {
  Experience as ExperienceType,
  Project,
  ContactLink,
} from "../types/portfolio";
import { translations } from "../i18n/utils";

const lang = "es";
const t = translations[lang];

const experience: ExperienceType[] = [
  {
    id: "1",
    company: "Nazaries Intelligence",
    role: "Desarrollador de Software Mid-Level",
    period: "2025 - Actualidad",
    description:
      "En esta etapa consolidé mi trabajo con arquitectura CLEAN y arquitectura hexagonal, profundizando en patrones de diseño y optimización del rendimiento en aplicaciones React. Participé en un proyecto de formularios complejos y de gran volumen, primero con Formik y más adelante con React Hook Form. También trabajé con MobX para la gestión de estado, comenzamos a introducir inyección de dependencias con Inversify y llevamos a cabo la migración de validaciones desde class-validator hacia Zod. Posteriormente colaboré con El Corte Inglés en el desarrollo de la pasarela de compra de entradas para teatros.",
    technologies: [
      "React",
      "TypeScript",
      "MobX",
      "Inversify",
      "Zod",
      "React Hook Form",
      "CLEAN Architecture",
    ],
  },
  {
    id: "2",
    company: "Nazaries Intelligence",
    role: "Desarrollador de Software Junior",
    period: "2023 - 2025",
    description:
      "Durante esta etapa continué trabajando con Ruby on Rails, aunque pronto orienté mi desarrollo profesional hacia el mundo de la interfaz y la experiencia de usuario. Empecé profundizando en JavaScript y React, colaborando con distintos equipos en la implementación de nuevos diseños y en la personalización de estilos sobre WordPress. Más adelante trabajé con Angular en un proyecto de biblioteca virtual infantil para Santillana, donde también incorporé Vue.js con Nuxt y adquirí experiencia adicional con Node.js y MongoDB.",
    technologies: [
      "React",
      "Angular",
      "Vue.js",
      "Nuxt",
      "Node.js",
      "MongoDB",
      "JavaScript",
      "WordPress",
      "Jest",
    ],
  },
  {
    id: "3",
    company: "Nazaries Intelligence",
    role: "Prácticas",
    period: "2022 - 2023",
    description:
      "Durante mis prácticas comencé a trabajar con Ruby on Rails y a familiarizarme con el patrón MVC. En esta etapa también aprendí a utilizar Docker y Git dentro de un entorno profesional. Tuve la oportunidad de participar tanto en proyectos internos como en tareas de mantenimiento y nuevos desarrollos para clientes.",
    technologies: ["Ruby on Rails", "MVC", "Docker", "Git"],
  },
];

const projects: Project[] = [];

const techStack = [
  "React",
  "TypeScript",
  "MobX",
  "Zod",
  "React Hook Form",
  "Vite",
  "Jest",
  "Nuxt",
  "Node.js",
  "MongoDB",
  "JavaScript",
  "WordPress",
  "Vue.js",
  "Ruby on Rails",
  "Docker",
  "Git",
  "Angular",
];

const contactLinks: ContactLink[] = [
  { name: "Email", url: "mailto:ruben051199@gmail.com" },
  {
    name: "LinkedIn",
    url: "https://linkedin.com/in/rubén-delgado-pareja-baaa67206",
  },
  { name: "Phone", url: "tel:+34662000647" },
];
---

<BaseLayout title="Ruben Delgado - Frontend Software Developer" lang={lang}>
  <About name="Ruben Delgado" about={t.about} location="Granada, Spain" contactLinks={contactLinks} />
  <TechStack technologies={techStack} title={t.techStack.title} />
  <Experience experiences={experience} title={t.experience.title} />
  <Projects projects={projects} title={t.projects} />
</BaseLayout>
