---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import type {
  Experience as ExperienceType,
  Project,
  ContactLink,
} from "../types/portfolio";
import { translations } from "../i18n/utils";

const lang = "en";
const t = translations[lang];

const experience: ExperienceType[] = [
  {
    id: "1",
    company: "Nazaríes Intelligenia",
    role: "Software Engineer",
    period: "Jul 2022 – Present",
    description:
      "Digital consultancy delivering web platforms for enterprise clients across Spain and the US.",
    highlights: [
      "Built the customer-facing booking platform for El Corte Inglés (2 theaters, multiple concurrent shows) — interactive seat selection with real-time availability checks, multi-step reservation flow, and Vitest integration tests protecting critical purchase paths.",
      "Owned end-to-end delivery of the scheduling module for a US-based SPA chain ERP: interactive calendar with event creation, employee assignment, and real-time updates via WebSockets in a distributed team of ~7 engineers.",
      "Collaborated directly with US stakeholders in daily standups and refinements, translating product requirements into technical specs.",
      "Applied Clean and Hexagonal Architecture patterns across projects to keep business logic decoupled from UI frameworks, enabling confident refactoring and easier testing.",
    ],
    technologies: [
      "React",
      "TypeScript",
      "Vite",
      "Vitest",
      "WebSockets",
      "Clean Architecture",
      "Zod",
      "MobX",
    ],
  },
];

const projects: Project[] = [
  {
    id: "1",
    label: "National ticketing",
    title: "El Corte Inglés — Theater Booking Platform",
    description:
      "Customer-facing booking platform for Spain's largest retailer, covering 2 theaters and multiple concurrent shows. Cross-functional team of 6 engineers.",
    outcome:
      "Launched to production handling real purchase traffic for El Corte Inglés theater shows across Spain, including high-demand release windows.",
    highlights: [
      "Designed and built the interactive seat selection UI with real-time availability checks, coordinating date, show, and seat state across a multi-step reservation flow.",
      "Optimized the seat-availability service requests, reducing redundant calls and improving page responsiveness during peak traffic on show release days.",
      "Wrote component and integration tests with Vitest to protect critical booking flows and prevent regressions in production releases.",
      "Built expert purchase channels for department store and travel agency employees with separate fulfillment flows.",
    ],
    technologies: ["React", "TypeScript", "Vite", "Vitest", "Zod", "MobX"],
  },
  {
    id: "2",
    label: "Enterprise ERP",
    title: "SPA Chain ERP — US Client",
    description:
      "Comprehensive ERP for a US-based SPA chain managing operations across multiple locations. Distributed team of ~7 engineers across Spain and the US.",
    outcome:
      "Client explicitly requested the same team for a follow-up project after delivery.",
    highlights: [
      "Owned end-to-end delivery of the scheduling module: interactive calendar with event creation, employee assignment, and real-time subscription to schedule changes via WebSockets.",
      "Developed core ERP modules including rooms, staff, materials, suppliers, and service catalog management.",
      "Collaborated directly with US stakeholders in daily standups and refinement sessions, translating product requirements into technical specs across timezones.",
    ],
    technologies: ["React", "TypeScript", "WebSockets"],
  },
  {
    id: "3",
    label: "Social impact platform",
    title: "Innicia / Plataforma360 — NGO Support Platform",
    description:
      "EU and Community of Madrid-funded platform connecting NGOs and support organizations for vulnerable groups.",
    outcome: "",
    highlights: [
      "Built multi-step forms for diverse request types and NGO submission flows with complex validation logic.",
      "Migrated from Formik to React Hook Form, reducing form bundle size and improving maintainability at scale.",
      "Applied Inversify for dependency injection, keeping business logic cleanly separated from UI layer.",
    ],
    technologies: [
      "React",
      "TypeScript",
      "React Hook Form",
      "Zod",
      "Inversify",
    ],
  },
  {
    id: "4",
    label: "Education product",
    title: "Santillana — Children's Digital Library",
    description:
      "Digital product for children to read books, listen to podcasts and audiobooks, and watch videos. Published by one of Spain's largest education publishers.",
    outcome: "",
    highlights: [
      "Led frontend development with Vue.js and Nuxt; contributed Angular and Node.js modules when needed.",
      "Built reading-progress tracking logic and the multi-format content consumption experience (text, audio, video).",
    ],
    technologies: ["Vue.js", "Nuxt", "Angular", "Node.js"],
  },
];

const contactLinks: ContactLink[] = [
  { name: "Email", url: "mailto:ruben051199@gmail.com" },
  {
    name: "LinkedIn",
    url: "https://linkedin.com/in/ruben-delgado-pareja",
  },
  {
    name: "GitHub",
    url: "https://github.com/RubenDelgadoPareja",
  },
];
---

<BaseLayout title="Rubén Delgado | Frontend Engineer" lang={lang}>
  <About
    name="Ruben Delgado"
    about={t.about}
    location="Granada, Spain"
    contactLinks={contactLinks}
  />
  <Experience experiences={experience} title="Software engineer" />
  <Projects projects={projects} title={t.projects} />
</BaseLayout>
