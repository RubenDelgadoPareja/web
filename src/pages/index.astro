---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import type {
  Experience as ExperienceType,
  Project,
  ContactLink,
} from "../types/portfolio";
import { translations } from "../i18n/utils";

const lang = "en";
const t = translations[lang];

const experience: ExperienceType[] = [
  {
    id: "1",
    company: "Nazaries Intelligence",
    role: "Software engineer",
    period: "2022 – Present",
    description:
      "Working at Nazaries Intelligence from 2022 to the present, growing from internship to product-focused software engineer.",
    highlights: [
      "Built the ticketing platform for El Corte Inglés, including purchase flow, seat selection, PGP payment, and post-sale operations.",
      "Delivered B2B dashboards for hotel and cruise spa operations with scheduling, resources, and service management.",
      "Helped evolve the frontend architecture with CLEAN principles, stronger validation with Zod, and scalable state management with MobX.",
    ],
    technologies: [
      "React",
      "TypeScript",
      "MobX",
      "Zod",
      "CLEAN",
      "Vite",
      "Vitest",
    ],
  },
];

const projects: Project[] = [
  {
    id: "1",
    label: "National ticketing",
    title: "El Corte Inglés — Ticketing platform for musicals and theaters",
    description:
      "Full redesign and rebuild of the national ticketing system following a provider change.",
    outcome: "",
    highlights: [
      "End-to-end purchase flow: calendar, zone/seat selection, PGP payment, thank you page.",
      "Expert channels for employees across web, department stores, and travel agencies.",
      "Self-service post-sale for ticket lookup, cancellations, and refunds.",
    ],
    technologies: ["React", "TypeScript", "Zod", "MobX"],
  },
  {
    id: "2",
    label: "B2B dashboard",
    title: "RTR / Real Time Services — Spa management for hotels and cruises",
    description:
      "B2B SPA to manage spa services and operations in hotels, cruises, and similar environments.",
    outcome: "",
    highlights: [
      "Calendar-based scheduling with provider, room, and time filters.",
      "Rooms, staff, materials, schedules, and service catalog management.",
      "Took on responsibility beyond expected level; client explicitly requested the same team for a follow-up project.",
    ],
    technologies: ["React", "JavaScript"],
  },
  {
    id: "3",
    label: "Complex dashboard",
    title:
      "Innicia / Plataforma360 — Support platform for social organizations",
    description:
      "EU and Community of Madrid-funded platform connecting NGOs and support organizations for vulnerable groups.",
    outcome: "",
    highlights: [
      "Multi-step forms for different request types and NGO submission flows.",
      "Migrated from Formik to React Hook Form for better maintainability at scale.",
    ],
    technologies: [
      "React",
      "TypeScript",
      "React Hook Form",
      "Zod",
      "Inversify",
    ],
  },
  {
    id: "4",
    label: "Education product",
    title: "Children's virtual library for Santillana",
    description:
      "Digital product for children to read, listen to podcasts, audiobooks, and watch videos.",
    outcome: "",
    highlights: [
      "Main development with Vue.js and Nuxt; contributed with Angular and Node.js when needed.",
      "Built reading-tracking logic and multi-format book consumption experience.",
    ],
    technologies: ["Vue.js", "Nuxt", "Angular", "Node.js"],
  },
];

const contactLinks: ContactLink[] = [
  { name: "Email", url: "mailto:ruben051199@gmail.com" },
  {
    name: "LinkedIn",
    url: "https://linkedin.com/in/rubén-delgado-pareja-baaa67206",
  },
  { name: "Phone", url: "tel:+34662000647" },
];
---

<BaseLayout title="Ruben Delgado | Software Engineer" lang={lang}>
  <About
    name="Ruben Delgado"
    about={t.about}
    location="Granada, Spain"
    contactLinks={contactLinks}
  />
  <Experience experiences={experience} title="Software engineer" />
  <Projects projects={projects} title={t.projects} />
</BaseLayout>
