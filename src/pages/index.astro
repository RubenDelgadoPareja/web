---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import ExperienceSection from '../components/Experience.astro';
import type { Experience as ExperienceType, Project, SkillCategory, ContactLink } from '../types/portfolio';

const experience: ExperienceType[] = [
  {
    id: '1',
    company: 'Tu Empresa',
    role: 'Desarrollador Full Stack',
    period: '2023 - Actualidad',
    description: 'Desarrollo de aplicaciones web modernas con React, Node.js y bases de datos PostgreSQL.',
    technologies: ['React', 'Node.js', 'PostgreSQL', 'TypeScript']
  },
  {
    id: '2',
    company: 'Empresa Anterior',
    role: 'Desarrollador Frontend',
    period: '2021 - 2023',
    description: 'Implementación de interfaces de usuario responsivas y optimización de rendimiento.',
    technologies: ['JavaScript', 'CSS', 'HTML', 'Vue.js']
  }
];

const projects: Project[] = [
  {
    id: '1',
    title: 'Proyecto 1',
    description: 'Descripción de tu proyecto destacado.',
    technologies: ['React', 'TypeScript', 'Node.js'],
    github: 'https://github.com'
  },
  {
    id: '2',
    title: 'Proyecto 2',
    description: 'Otro proyecto interesante.',
    technologies: ['Astro', 'Tailwind', 'PostgreSQL'],
    link: 'https://demo.com',
    github: 'https://github.com'
  }
];

const skills: SkillCategory[] = [
  {
    name: 'Frontend',
    skills: [
      { name: 'JavaScript' },
      { name: 'TypeScript' },
      { name: 'React' },
      { name: 'Astro' },
      { name: 'HTML/CSS' }
    ]
  },
  {
    name: 'Backend',
    skills: [
      { name: 'Node.js' },
      { name: 'Python' },
      { name: 'PostgreSQL' },
      { name: 'MongoDB' }
    ]
  },
  {
    name: 'Herramientas',
    skills: [
      { name: 'Git' },
      { name: 'Docker' },
      { name: 'AWS' },
      { name: 'Linux' }
    ]
  }
];

const contactLinks: ContactLink[] = [
  { name: 'GitHub', url: 'https://github.com' },
  { name: 'LinkedIn', url: 'https://linkedin.com' },
  { name: 'Email', url: 'mailto:tuemail@ejemplo.com' }
];
---

<BaseLayout title="Ruben Delgado - Desarrollador de Software">
  <About 
    name="Ruben Delgado" 
    title="Desarrollador de Software" 
    bio="Desarrollador passionate por crear experiencias web modernas y eficientes. Me especializo en el desarrollo full stack con tecnologías modernas."
  />
  <ExperienceSection experiences={experience} />
  <Projects projects={projects} />
  <Skills categories={skills} />
  <Contact links={contactLinks} />
</BaseLayout>
