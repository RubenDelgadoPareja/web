---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import type { Experience as ExperienceType, Project, SkillCategory, ContactLink } from '../types/portfolio';
import { translations } from '../i18n/utils';

const lang = 'es';
const t = translations[lang];

const experience: ExperienceType[] = [
  {
    id: '1',
    company: 'El Corte Inglés',
    role: 'Intermediate Software Dev',
    period: '2024 - Present',
    description: 'Development of booking platform for theater shows. Date and seat selection system implementation.',
    technologies: ['React', 'TypeScript', 'CLEAN Architecture']
  },
  {
    id: '2',
    company: 'SPA Chain (US Client)',
    role: 'Software Developer',
    period: '2023 - 2024',
    description: 'ERP system for comprehensive SPA chain management. Modules for rooms, materials, resources and suppliers. Advanced calendar with events and employee assignment.',
    technologies: ['React', 'TypeScript', 'Vite', 'Vitest']
  },
  {
    id: '3',
    company: 'Freelance / Other Projects',
    role: 'Frontend Developer',
    period: '2022 - 2023',
    description: 'Web applications with CLEAN and hexagonal architecture. Development with Angular, Vue.js and React. Component testing with Jest.',
    technologies: ['Angular', 'Vue.js', 'React', 'Jest', 'Docker']
  }
];

const projects: Project[] = [];

const skills: SkillCategory[] = [
  {
    name: 'Tech Stack',
    skills: [
      { name: 'React.js' },
      { name: 'TypeScript' },
      { name: 'Vite' },
      { name: 'Vitest' },
      { name: 'Docker' }
    ]
  },
  {
    name: 'Soft Skills',
    skills: [
      { name: 'Teamworker' },
      { name: 'Responsible' },
      { name: 'Problem Solving' },
      { name: 'Independent' },
      { name: 'Hard Working' }
    ]
  },
  {
    name: 'Languages',
    skills: [
      { name: 'Spanish (Native)' },
      { name: 'English (B2)' }
    ]
  }
];

const contactLinks: ContactLink[] = [
  { name: 'Email', url: 'mailto:ruben051199@gmail.com' },
  { name: 'LinkedIn', url: 'https://linkedin.com/in/rubén-delgado-pareja-baaa67206' },
  { name: 'Phone', url: 'tel:+34662000647' }
];
---

<BaseLayout title="Ruben Delgado - Frontend Software Developer" lang={lang}>
  <About 
    name="Ruben Delgado" 
    about={t.about}
    location="Granada, Spain"
  />
  <Experience experiences={experience} title={t.experience.title} />
  <Projects projects={projects} title={t.projects} />
  <Skills categories={skills} title={t.skills.title} />
  <Contact links={contactLinks} title={t.contact.title} description={t.contact.description} />
</BaseLayout>
