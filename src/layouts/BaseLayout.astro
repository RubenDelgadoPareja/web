---
import '../styles/global.css';
import LanguageSelector from '../components/LanguageSelector';
import { translations } from '../i18n/utils';

interface Props {
  title: string;
  lang: 'es' | 'en';
}

const { title, lang } = Astro.props;

const t = translations[lang];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={lang === 'es' ? 'Portfolio de Desarrollador de Software' : 'Software Developer Portfolio'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 text-stone-800 min-h-screen">
    <header class="fixed top-0 left-0 right-0 h-16 bg-stone-50/95 backdrop-blur-sm border-b border-stone-200 z-50">
      <nav class="max-w-4xl mx-auto px-6 h-full flex items-center justify-between">
        <a href={lang === 'es' ? '/' : '/en/'} class="text-2xl font-bold text-emerald-600">RD</a>
        <div class="flex items-center gap-6">
          <ul class="flex gap-6 text-sm font-medium">
            <li><a href={`#about`} class="hover:text-emerald-600 transition-colors">{t.nav.about}</a></li>
            <li><a href={`#experience`} class="hover:text-emerald-600 transition-colors">{t.nav.experience}</a></li>
            <li><a href={`#projects`} class="hover:text-emerald-600 transition-colors">{t.nav.projects}</a></li>
            <li><a href={`#skills`} class="hover:text-emerald-600 transition-colors">{t.nav.skills}</a></li>
            <li><a href={`#contact`} class="hover:text-emerald-600 transition-colors">{t.nav.contact}</a></li>
          </ul>
          <LanguageSelector currentLang={lang} client:load />
        </div>
      </nav>
    </header>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="py-8 text-center bg-stone-900 text-stone-400 text-sm">
      <div class="max-w-4xl mx-auto px-6">
        <p>&copy; {new Date().getFullYear()} Ruben Delgado. {t.footer.rights}</p>
      </div>
    </footer>
  </body>
</html>
