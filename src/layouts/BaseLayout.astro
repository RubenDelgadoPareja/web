---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { translations } from "../i18n/utils";

interface Props {
  title: string;
  lang: "es" | "en";
  description?: string;
}

const { title, lang, description } = Astro.props;

const t = translations[lang];

const siteUrl = "https://ruben-delgado.dev";
const currentUrl = Astro.url;
const normalizedPath = currentUrl.pathname.endsWith("/")
  ? currentUrl.pathname
  : `${currentUrl.pathname}/`;
const canonicalUrl = `${siteUrl}${normalizedPath}`;
const ogImageUrl = `${siteUrl}/og-image.svg`;
const sitemapUrl = `${siteUrl}/sitemap-index.xml`;

const pageDescription =
  description ??
  "Rubén Delgado — Frontend Engineer with 3+ years shipping React & TypeScript apps for El Corte Inglés and US enterprise clients. Based in Granada, Spain.";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      name: "Rubén Delgado",
      url: `${siteUrl}/`,
      image: `${siteUrl}/avatar.jpeg`,
      jobTitle: "Frontend Engineer",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Granada",
        addressCountry: "ES",
      },
      email: "mailto:ruben051199@gmail.com",
      sameAs: [
        "https://linkedin.com/in/ruben-delgado-pareja",
        "https://github.com/RubenDelgadoPareja",
      ],
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Universidad de Granada",
        url: "https://www.ugr.es",
      },
      knowsAbout: [
        "React",
        "TypeScript",
        "JavaScript",
        "Frontend Development",
        "Clean Architecture",
        "Hexagonal Architecture",
        "Component Testing",
        "Vitest",
        "WebSockets",
        "Vite",
        "Vue.js",
        "Next.js",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Rubén Delgado — Frontend Engineer",
      inLanguage: ["en"],
      description: pageDescription,
      author: {
        "@id": `${siteUrl}/#person`,
      },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description: pageDescription,
      isPartOf: {
        "@id": `${siteUrl}/#website`,
      },
      about: {
        "@id": `${siteUrl}/#person`,
      },
      inLanguage: lang,
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImageUrl,
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#f1f0ec" />

    <!-- Preconnect para Google Fonts (Core Web Vitals) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Rubén Delgado" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapUrl} />

    <!-- Identidad en redes -->
    <link rel="me" href="https://linkedin.com/in/ruben-delgado-pareja" />
    <link rel="me" href="https://github.com/RubenDelgadoPareja" />
    <link rel="me" href="mailto:ruben051199@gmail.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Rubén Delgado — Frontend Engineer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rubén Delgado — Frontend Engineer portfolio" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="bg-[var(--bg)] text-[var(--text)]">
    <!-- Skip Link for Accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--accent)] focus:text-white focus:rounded-md focus:outline-none"
    >
      Skip to main content
    </a>


    <main id="main-content" class="" tabindex="-1" role="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--line)] py-8" role="contentinfo">
      <div class="mx-auto max-w-5xl px-6">
        <p
          class="text-center text-xs uppercase tracking-[0.16em] text-[var(--muted)]"
        >
          © {new Date().getFullYear()} Ruben Delgado
        </p>
      </div>
    </footer>
    <Analytics />
  </body>
</html>

<script>
  // Cursor spotlight
  window.addEventListener('mousemove', (e) => {
    document.documentElement.style.setProperty('--mouse-x', e.clientX + 'px');
    document.documentElement.style.setProperty('--mouse-y', e.clientY + 'px');
  });

</script>
