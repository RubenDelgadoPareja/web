---
import "../styles/global.css";
import LanguageSelector from "../components/LanguageSelector";
import ThemeToggle from "../components/ThemeToggle.astro";
import { translations } from "../i18n/utils";

interface Props {
  title: string;
  lang: "es" | "en";
  showNav?: boolean;
  description?: string;
}

const { title, lang, showNav = true, description } = Astro.props;

const t = translations[lang];

const siteUrl = "https://ruben-delgado.dev";
const currentUrl = Astro.url;
const normalizedPath = currentUrl.pathname.endsWith("/")
  ? currentUrl.pathname
  : `${currentUrl.pathname}/`;
const stackSectionId = "tech-stack";
const canonicalUrl = `${siteUrl}${normalizedPath}`;
const homeUrl = `${siteUrl}/`;
const englishHomeUrl = `${siteUrl}/en/`;
const ogImageUrl = `${siteUrl}/og-image.svg`;
const sitemapUrl = `${siteUrl}/sitemap-index.xml`;
const locale = lang === "es" ? "es_ES" : "en_US";
const alternateLocale = lang === "es" ? "en_US" : "es_ES";

const descriptions = {
  es: "Portfolio de Ruben Delgado, frontend engineer especializado en React y TypeScript. Experiencia en producto real, formularios complejos, arquitectura mantenible e interfaces orientadas a negocio.",
  en: "Portfolio of Ruben Delgado, a frontend engineer specialized in React and TypeScript. Experience in real products, complex form flows, maintainable architecture, and business-oriented interfaces."
};

const pageDescription = description ?? descriptions[lang];

const alternates =
  normalizedPath === "/" || normalizedPath === "/en/"
    ? [
        { hrefLang: "es", href: homeUrl },
        { hrefLang: "en", href: englishHomeUrl },
        { hrefLang: "x-default", href: homeUrl },
      ]
    : [];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Ruben Delgado',
      url: `${siteUrl}/`,
      image: ogImageUrl,
      jobTitle: lang === 'es' ? 'Frontend Engineer' : 'Frontend Engineer',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Granada',
        addressCountry: 'ES',
      },
      email: 'mailto:ruben051199@gmail.com',
      sameAs: ['https://linkedin.com/in/rubén-delgado-pareja-baaa67206'],
      knowsAbout: ['React', 'TypeScript', 'JavaScript', 'Frontend Development', 'UI Engineering', 'Astro'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Ruben Delgado Portfolio',
      inLanguage: ['es', 'en'],
      description: pageDescription,
      author: {
        '@id': `${siteUrl}/#person`,
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description: pageDescription,
      isPartOf: {
        '@id': `${siteUrl}/#website`,
      },
      about: {
        '@id': `${siteUrl}/#person`,
      },
      inLanguage: lang,
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageUrl,
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f172a" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Ruben Delgado" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Ruben Delgado - Frontend Developer" />
    <meta property="og:locale" content={locale} />
    {alternates.length > 0 && <meta property="og:locale:alternate" content={alternateLocale} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ruben Delgado portfolio preview" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternates.map(({ hrefLang, href }) => (
      <link rel="alternate" hreflang={hrefLang} href={href} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      const theme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
  </head>
  <body class="bg-stone-50 dark:bg-stone-900 text-stone-800 dark:text-stone-100 transition-colors">
    <!-- Skip Link for Accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-lg focus:outline-none"
    >
      {lang === "es" ? "Saltar al contenido principal" : "Skip to main content"}
    </a>

    {showNav && (
      <header class="fixed top-0 left-0 right-0 bg-white/80 dark:bg-stone-900/80 backdrop-blur-md border-b border-stone-200 dark:border-stone-700 z-50" role="banner">
        <nav class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between" role="navigation" aria-label="Main navigation">
          <a href={lang === "es" ? "/" : "/en/"} class="text-xl font-bold text-primary" aria-label="Ruben Delgado - Home">
            RD
          </a>

          <!-- Desktop Navigation -->
          <ul class="hidden md:flex items-center gap-8" role="menubar">
            <li role="none">
              <a href="#about" class="text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors" role="menuitem">
                {t.nav.about}
              </a>
            </li>
            <li role="none">
              <a href={`#${stackSectionId}`} class="text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors" role="menuitem">
                {t.nav.skills}
              </a>
            </li>
            <li role="none">
              <a href="#experience" class="text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors" role="menuitem">
                {t.nav.experience}
              </a>
            </li>
            <li role="none">
              <a href="#projects" class="text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors" role="menuitem">
                {t.nav.projects}
              </a>
            </li>
          </ul>

          <div class="flex items-center gap-2">
            <LanguageSelector currentLang={lang} />

            <!-- Mobile Menu Button -->
            <button
              id="mobile-menu-btn"
              class="md:hidden p-2 text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark focus:outline-none focus:ring-2 focus:ring-primary rounded-lg"
              aria-label={lang === "es" ? "Abrir menú" : "Open menu"}
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 menu-open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 menu-close hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>

            <ThemeToggle lang={lang} />
          </div>
        </nav>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-white dark:bg-stone-900 border-t border-stone-200 dark:border-stone-700" role="menu">
          <ul class="px-6 py-4 space-y-4">
            <li role="none">
              <a href="#about" class="block text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors" role="menuitem">
                {t.nav.about}
              </a>
            </li>
            <li role="none">
              <a href={`#${stackSectionId}`} class="block text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors" role="menuitem">
                {t.nav.skills}
              </a>
            </li>
            <li role="none">
              <a href="#experience" class="block text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors" role="menuitem">
                {t.nav.experience}
              </a>
            </li>
            <li role="none">
              <a href="#projects" class="block text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors" role="menuitem">
                {t.nav.projects}
              </a>
            </li>
            <li class="pt-4 border-t border-stone-200 dark:border-stone-700">
              <div class="flex items-center gap-3">
                <ThemeToggle lang={lang} />
              </div>
            </li>
          </ul>
        </div>
      </header>
    )}

    <main id="main-content" class={showNav ? "pt-16" : ""} tabindex="-1" role="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="py-8 border-t border-stone-200 dark:border-stone-700" role="contentinfo">
      <div class="max-w-4xl mx-auto px-6">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <p class="text-stone-500 dark:text-stone-400 text-sm">
            © {new Date().getFullYear()} Ruben Delgado. {t.footer.rights}
          </p>
          <nav aria-label="Legal links">
            <ul class="flex flex-wrap justify-center gap-6 text-sm">
              <li>
                <a href="/cookies" class="text-stone-500 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors">
                  {lang === "es" ? "Política de Cookies" : "Cookie Policy"}
                </a>
              </li>
              <li>
                <a href="/privacidad" class="text-stone-500 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors">
                  {lang === "es" ? "Política de Privacidad" : "Privacy Policy"}
                </a>
              </li>
              <li>
                <a href="/legal" class="text-stone-500 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors">
                  {lang === "es" ? "Aviso Legal" : "Legal Notice"}
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const animateElements = document.querySelectorAll(".fade-in-up, .fade-in-left, .fade-in-right");

  animateElements.forEach((el) => {
    gsap.fromTo(el,
      {
        autoAlpha: 0,
        y: 50
      },
      {
        autoAlpha: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
        scrollTrigger: {
          trigger: el,
          start: "top 88%",
          toggleActions: "play none none none"
        }
      }
    );
  });

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      mobileMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      mobileMenuBtn.querySelector('.menu-open')?.classList.toggle('hidden');
      mobileMenuBtn.querySelector('.menu-close')?.classList.toggle('hidden');
    });

    // Close menu when clicking on a link
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenuBtn.setAttribute('aria-expanded', 'false');
        mobileMenuBtn.querySelector('.menu-open')?.classList.remove('hidden');
        mobileMenuBtn.querySelector('.menu-close')?.classList.add('hidden');
      });
    });
  }
</script>
