---
import "../styles/global.css";
import LanguageSelector from "../components/LanguageSelector";
import ThemeToggle from "../components/ThemeToggle.astro";
import { translations } from "../i18n/utils";

interface Props {
  title: string;
  lang: "es" | "en";
  showNav?: boolean;
}

const { title, lang, showNav = true } = Astro.props;

const t = translations[lang];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={lang === "es"
        ? "Portfolio de Desarrollador Frontend"
        : "Frontend Developer Portfolio"}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      const theme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
  </head>
  <body class="bg-stone-50 dark:bg-stone-900 text-stone-800 dark:text-stone-100 transition-colors">
    {showNav && (
      <header class="fixed top-0 left-0 right-0 bg-white/80 dark:bg-stone-900/80 backdrop-blur-md border-b border-stone-200 dark:border-stone-700 z-50">
        <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
          <a href={lang === "es" ? "/" : "/en/"} class="text-xl font-bold text-primary">
            RD
          </a>
          
          <ul class="hidden md:flex items-center gap-8">
            <li>
              <a href="#about" class="text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors">
                {t.nav.about}
              </a>
            </li>
            <li>
              <a href="#experience" class="text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors">
                {t.nav.experience}
              </a>
            </li>
            <li>
              <a href="#projects" class="text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors">
                {t.nav.projects}
              </a>
            </li>
            <li>
              <a href="#skills" class="text-stone-600 dark:text-stone-400 hover:text-primary dark:hover:text-primary-dark transition-colors">
                {t.nav.skills}
              </a>
            </li>
          </ul>
          
          <div class="flex items-center gap-3">
            <ThemeToggle lang={lang} />
            <LanguageSelector currentLang={lang} client:load />
          </div>
        </nav>
      </header>
    )}

    <main class={showNav ? "pt-20" : ""}>
      <slot />
    </main>
  </body>
</html>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
   
  gsap.registerPlugin(ScrollTrigger);
   
  const animateElements = document.querySelectorAll(".fade-in-up, .fade-in-left, .fade-in-right");
   
  animateElements.forEach((el) => {
    gsap.fromTo(el, 
      { 
        autoAlpha: 0, 
        y: 50 
      },
      {
        autoAlpha: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
        scrollTrigger: {
          trigger: el,
          start: "top 88%",
          toggleActions: "play none none none"
        }
      }
    );
  });
</script>
