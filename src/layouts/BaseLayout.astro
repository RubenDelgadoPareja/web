---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { translations } from "../i18n/utils";

interface Props {
  title: string;
  lang: "es" | "en";
  showNav?: boolean;
  description?: string;
}

const { title, lang, showNav = true, description } = Astro.props;

const t = translations[lang];

const siteUrl = "https://ruben-delgado.dev";
const currentUrl = Astro.url;
const normalizedPath = currentUrl.pathname.endsWith("/")
  ? currentUrl.pathname
  : `${currentUrl.pathname}/`;
const canonicalUrl = `${siteUrl}${normalizedPath}`;
const ogImageUrl = `${siteUrl}/og-image.svg`;
const sitemapUrl = `${siteUrl}/sitemap-index.xml`;

const pageDescription = description ?? "Portfolio of Ruben Delgado, a software engineer specializing in React and TypeScript.";


const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Ruben Delgado',
      url: `${siteUrl}/`,
      image: ogImageUrl,
      jobTitle: 'Software Engineer',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Granada',
        addressCountry: 'ES',
      },
      email: 'mailto:ruben051199@gmail.com',
      sameAs: ['https://linkedin.com/in/rubén-delgado-pareja-baaa67206'],
      knowsAbout: ['React', 'TypeScript', 'JavaScript', 'Frontend Development', 'UI Engineering', 'Astro'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Ruben Delgado Portfolio',
      inLanguage: ['en'],
      description: pageDescription,
      author: {
        '@id': `${siteUrl}/#person`,
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description: pageDescription,
      isPartOf: {
        '@id': `${siteUrl}/#website`,
      },
      about: {
        '@id': `${siteUrl}/#person`,
      },
      inLanguage: lang,
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageUrl,
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#f7f6f2" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Ruben Delgado" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Ruben Delgado - Software Engineer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ruben Delgado portfolio preview" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-[var(--bg)] text-[var(--text)]">
    <!-- Skip Link for Accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--accent)] focus:text-white focus:rounded-md focus:outline-none"
    >
      Skip to main content
    </a>

    {showNav && (
      <header class="fixed top-0 left-0 right-0 z-50 border-b border-[var(--line)] bg-[var(--surface)]/95 backdrop-blur" role="banner">
        <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4" role="navigation" aria-label="Main navigation">
          <a href="/" class="text-lg font-semibold tracking-tight text-[var(--text)]" aria-label="Ruben Delgado - Home">
            RD
          </a>

          <!-- Desktop Navigation -->
          <ul class="hidden items-center gap-8 md:flex" role="menubar">
            <li role="none">
              <a href="#about" class="text-xs uppercase tracking-[0.22em] text-[var(--muted)] hover:text-[var(--text)]" role="menuitem">
                {t.nav.about}
              </a>
            </li>
            <li role="none">
              <a href="#experience" class="text-xs uppercase tracking-[0.22em] text-[var(--muted)] hover:text-[var(--text)]" role="menuitem">
                {t.nav.experience}
              </a>
            </li>
            <li role="none">
              <a href="#projects" class="text-xs uppercase tracking-[0.22em] text-[var(--muted)] hover:text-[var(--text)]" role="menuitem">
                {t.nav.projects}
              </a>
            </li>
          </ul>

          <div class="flex items-center">
            <!-- Mobile Menu Button -->
            <button
              id="mobile-menu-btn"
              class="rounded-md border border-[var(--line)] p-2 text-[var(--muted)] hover:text-[var(--text)] focus:outline-none md:hidden"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 menu-open" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 menu-close hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </nav>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden border-t border-[var(--line)] bg-[color:var(--surface)] md:hidden" role="menu">
          <ul class="px-6 py-4 space-y-4">
            <li role="none">
              <a href="#about" class="block text-xs uppercase tracking-[0.2em] text-[var(--muted)]" role="menuitem">
                {t.nav.about}
              </a>
            </li>
            <li role="none">
              <a href="#experience" class="block text-xs uppercase tracking-[0.2em] text-[var(--muted)]" role="menuitem">
                {t.nav.experience}
              </a>
            </li>
            <li role="none">
              <a href="#projects" class="block text-xs uppercase tracking-[0.2em] text-[var(--muted)]" role="menuitem">
                {t.nav.projects}
              </a>
            </li>
          </ul>
        </div>
      </header>
    )}

    <main id="main-content" class={showNav ? "pt-16" : ""} tabindex="-1" role="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--line)] py-8" role="contentinfo">
      <div class="mx-auto max-w-5xl px-6">
        <p class="text-center text-xs uppercase tracking-[0.16em] text-[var(--muted)]">
          © {new Date().getFullYear()} Ruben Delgado
        </p>
      </div>
    </footer>
    <Analytics />
  </body>
</html>

<script>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      mobileMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      mobileMenuBtn.querySelector('.menu-open')?.classList.toggle('hidden');
      mobileMenuBtn.querySelector('.menu-close')?.classList.toggle('hidden');
    });

    // Close menu when clicking on a link
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenuBtn.setAttribute('aria-expanded', 'false');
        mobileMenuBtn.querySelector('.menu-open')?.classList.remove('hidden');
        mobileMenuBtn.querySelector('.menu-close')?.classList.add('hidden');
      });
    });
  }
</script>
