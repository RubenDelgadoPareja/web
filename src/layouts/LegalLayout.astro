---
import "../styles/global.css";

interface Props {
  title: string;
  lang: "es" | "en";
}

const { title, lang } = Astro.props;
const currentPath = Astro.url.pathname;

const legalLinks = [
  { href: "/cookies", labelEs: "Cookies", labelEn: "Cookies" },
  { href: "/privacidad", labelEs: "Privacidad", labelEn: "Privacy" },
  { href: "/legal", labelEs: "Legal", labelEn: "Legal" },
];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={lang === "es" ? "Página legal" : "Legal page"} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`https://ruben-delgado.dev${Astro.url.pathname}`} />
    <script is:inline>
      const theme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
  </head>
  <body class="min-h-screen bg-[radial-gradient(circle_at_top,_rgba(59,130,246,0.10),_transparent_35%),linear-gradient(180deg,_#f8fafc_0%,_#eef2f7_100%)] text-stone-800 dark:bg-[radial-gradient(circle_at_top,_rgba(59,130,246,0.12),_transparent_30%),linear-gradient(180deg,_#0f172a_0%,_#111827_100%)] dark:text-stone-100 flex flex-col">
    <header class="sticky top-0 z-40 border-b border-stone-200/80 bg-white/80 backdrop-blur-md dark:border-stone-700/80 dark:bg-stone-950/75">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href={lang === "es" ? "/" : "/en/"} class="text-xl font-bold text-primary transition-opacity hover:opacity-80">
          RD
        </a>
        <a
          href={lang === "es" ? "/" : "/en/"}
          class="inline-flex items-center gap-2 rounded-full border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary hover:text-primary dark:border-stone-600 dark:bg-stone-900 dark:text-stone-200 dark:hover:border-primary-dark dark:hover:text-primary-dark"
        >
          <span aria-hidden="true">←</span>
          {lang === "es" ? "Volver al inicio" : "Back to home"}
        </a>
      </div>

      <div class="mx-auto max-w-5xl px-6 pb-4">
        <nav aria-label="Legal" class="flex flex-wrap gap-2">
          {legalLinks.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <a
                href={link.href}
                class={`rounded-full px-4 py-2 text-sm font-medium transition-colors ${isActive
                  ? 'bg-stone-900 text-white dark:bg-white dark:text-stone-900'
                  : 'bg-stone-100 text-stone-600 hover:bg-stone-200 hover:text-stone-900 dark:bg-stone-800 dark:text-stone-300 dark:hover:bg-stone-700 dark:hover:text-white'}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {lang === "es" ? link.labelEs : link.labelEn}
              </a>
            );
          })}
        </nav>
      </div>
    </header>

    <main class="flex-1 w-full px-6 py-10 sm:py-14">
      <div class="mx-auto max-w-5xl">
        <article class="overflow-hidden rounded-[2rem] border border-white/70 bg-white/75 p-6 shadow-[0_20px_70px_rgba(15,23,42,0.08)] backdrop-blur-sm dark:border-stone-800 dark:bg-stone-900/70 dark:shadow-[0_20px_70px_rgba(2,6,23,0.45)] sm:p-10">
        <slot />
        </article>
      </div>
    </main>

    <footer class="border-t border-stone-200/80 py-6 dark:border-stone-700/80">
      <div class="mx-auto max-w-5xl px-6">
        <div class="flex flex-col items-center justify-between gap-4 text-sm sm:flex-row">
          <p class="text-stone-500 dark:text-stone-400">
            © {new Date().getFullYear()} Ruben Delgado.
          </p>
          <nav aria-label="Legal">
            <ul class="flex flex-wrap justify-center gap-4 sm:gap-6">
              {legalLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-stone-500 transition-colors hover:text-primary dark:text-stone-400 dark:hover:text-primary-dark"
                  >
                    {lang === "es" ? link.labelEs : link.labelEn}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
