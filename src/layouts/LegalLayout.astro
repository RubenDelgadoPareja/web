---
import "../styles/global.css";

interface Props {
  title: string;
  lang: "es" | "en";
}

const { title, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      const theme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
  </head>
  <body class="bg-stone-50 dark:bg-stone-900 text-stone-800 dark:text-stone-100 min-h-screen">
    <header class="py-8 text-center">
      <a href={lang === "es" ? "/" : "/en/"} class="text-2xl font-bold text-blue-600 hover:scale-110 transition-transform">RD</a>
    </header>
    <main class="max-w-3xl mx-auto px-6 py-12">
      <slot />
    </main>
    <footer class="py-8 text-center text-stone-500 text-sm">
      <p>&copy; {new Date().getFullYear()} Ruben Delgado.</p>
    </footer>
  </body>
</html>
